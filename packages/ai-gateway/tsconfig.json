{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@aprovamind/ai-gateway": ["./src/index.ts"],
      "@aprovamind/ai-gateway/*": ["./src/*"],
      "@aprovamind/domain": ["../domain/src/index.ts"],
      "@aprovamind/domain/*": ["../domain/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
