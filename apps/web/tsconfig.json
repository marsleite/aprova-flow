{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@aprovamind/ai-gateway": ["../../packages/ai-gateway/src/index.ts"],
      "@aprovamind/ai-gateway/*": ["../../packages/ai-gateway/src/*"],
      "@aprovamind/domain": ["../../packages/domain/src/index.ts"],
      "@aprovamind/domain/*": ["../../packages/domain/src/*"],
      "@aprovamind/application": ["../../packages/application/src/index.ts"],
      "@aprovamind/application/*": ["../../packages/application/src/*"],
      "@aprovamind/contracts": ["../../packages/contracts/src/index.ts"],
      "@aprovamind/contracts/*": ["../../packages/contracts/src/*"],
      "@aprovamind/infrastructure-firebase": ["../../packages/infrastructure-firebase/src/index.ts"],
      "@aprovamind/infrastructure-firebase/*": ["../../packages/infrastructure-firebase/src/*"],
      "@aprovamind/infrastructure-billing": ["../../packages/infrastructure-billing/src/index.ts"],
      "@aprovamind/infrastructure-billing/*": ["../../packages/infrastructure-billing/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "scripts"]
}
