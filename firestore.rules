rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verifica se o usuário é admin
    function isAdmin() {
      return request.auth != null 
             && request.auth.token.email in [
               'marsleite@gmail.com',
               'graceandradeleite@gmail.com'
             ];
    }
    
    // Sessões de estudo
    match /sessions/{sessionId} {
      allow read: if request.auth != null 
                  && resource.data.userId == request.auth.uid;
      
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.subject is string
                    && request.resource.data.duration is number
                    && request.resource.data.date is string;
      
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
      
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }

    // Banco de questões (leitura para todos autenticados; escrita apenas admin)
    match /questions_bank/{questionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Provas oficiais (leitura para todos autenticados; escrita apenas admin)
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Tentativas de questões (histórico do usuário)
    match /question_attempts/{attemptId} {
      allow read: if request.auth != null 
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.questionId is string
                    && request.resource.data.selectedOption is string
                    && request.resource.data.correct is bool
                    && request.resource.data.timeSpentSeconds is number
                    && request.resource.data.attemptType in ['exam', 'simulado', 'treino'];

      allow delete: if false;
      allow update: if false;
    }

    // Configurações salvas de simulados (por usuário)
    match /simulated_configs/{configId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }
    
    // Configurações do usuário (meta semanal, plano ativo, etc.)
    match /user_stats/{userId} {
      allow read, write: if request.auth != null 
                         && request.auth.uid == userId;
    }

    // Estado ativo do cronômetro (documento único por usuário)
    match /active_timers/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.userId == resource.data.userId;

      allow delete: if false;
    }

    // Presença de telas conectadas ao cronômetro (subcoleção clients)
    match /timer_presence/{userId}/clients/{clientId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.clientId is string
                    && request.resource.data.lastSeenAt is string;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.clientId == resource.data.clientId
                    && request.resource.data.lastSeenAt is string;

      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }
    
    // Planos de estudo (editais)
    match /study_plans/{planId} {
      allow read: if request.auth != null 
                  && resource.data.userId == request.auth.uid;
      
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string;
      
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
      
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }
    
    // Registro de questões (acertos/erros)
    match /questions_stats/{docId} {
      allow read: if request.auth != null 
                  && resource.data.userId == request.auth.uid;
      
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.subject is string
                    && request.resource.data.totalQuestions is number;
      
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
      
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }

    // Benchmarks agregados (anônimos)
    // Qualquer usuário autenticado pode ler os benchmarks agregados
    match /benchmarks/{benchmarkId} {
      allow read: if request.auth != null;
    }

    // Benchmarks individuais do usuário
    // Apenas o proprietário pode ler e escrever seu próprio benchmark
    match /user_benchmarks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Telemetria de uso da IA
    // Cada usuário escreve apenas seus próprios eventos.
    match /ai_usage_events/{eventId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.route is string
                    && request.resource.data.task is string
                    && request.resource.data.provider is string
                    && request.resource.data.model is string
                    && request.resource.data.latencyMs is number
                    && request.resource.data.inputTokens is number
                    && request.resource.data.outputTokens is number
                    && request.resource.data.totalTokens is number
                    && request.resource.data.estimatedCostUsd is number
                    && request.resource.data.success is bool
                    && request.resource.data.statusCode is number;

      allow update, delete: if false;
    }

    // Snapshots do plano diário gerado por IA
    match /daily_ai_plans/{planId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.dateISO is string
                    && request.resource.data.estimatedTotalMinutes is number
                    && request.resource.data.blocksCount is number
                    && request.resource.data.rationale is string
                    && request.resource.data.planJson is string
                    && request.resource.data.provider is string
                    && request.resource.data.model is string
                    && request.resource.data.createdAt is string;

      allow update, delete: if false;
    }

    // Contadores de quota/rate limit de IA (janela distribuída)
    match /ai_rate_limits/{docId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.task is string
                    && request.resource.data.planTier is string
                    && request.resource.data.window is string
                    && request.resource.data.windowKey is string
                    && request.resource.data.windowStartMs is number
                    && request.resource.data.windowEndMs is number
                    && request.resource.data.count is number
                    && request.resource.data.updatedAt is string;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.task == resource.data.task
                    && request.resource.data.window == resource.data.window
                    && request.resource.data.windowKey == resource.data.windowKey
                    && request.resource.data.windowStartMs is number
                    && request.resource.data.windowEndMs is number
                    && request.resource.data.count is number
                    && request.resource.data.updatedAt is string;

      allow delete: if false;
    }

    // Progresso de execução do plano diário (concluir/adiar blocos)
    match /daily_ai_plan_progress/{progressId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.dateISO is string
                    && request.resource.data.planSignature is string
                    && request.resource.data.completedBlocks is list
                    && request.resource.data.deferredBlocks is list
                    && request.resource.data.updatedAt is string;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.dateISO == resource.data.dateISO
                    && request.resource.data.planSignature is string
                    && request.resource.data.completedBlocks is list
                    && request.resource.data.deferredBlocks is list
                    && request.resource.data.updatedAt is string;

      allow delete: if false;
    }

    // Eventos do calendário
    // Apenas o proprietário pode gerenciar seus eventos
    match /calendar_events/{eventId} {
      allow read: if request.auth != null 
                  && resource.data.userId == request.auth.uid;
      
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.subject is string
                    && request.resource.data.startTime is timestamp
                    && request.resource.data.endTime is timestamp
                    && request.resource.data.duration is number
                    && request.resource.data.type in ['study', 'review', 'test', 'break']
                    && request.resource.data.status in ['scheduled', 'completed', 'cancelled']
                    && request.resource.data.priority in ['low', 'medium', 'high'];
      
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
      
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }
    
    // Bloqueia tudo que não esteja permitido
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
