rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Sessões de estudo
    match /sessions/{sessionId} {
      allow read: if request.auth != null 
                  && resource.data.userId == request.auth.uid;
      
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.subject is string
                    && request.resource.data.duration is number
                    && request.resource.data.date is string;
      
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
      
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }
    
    // Configurações do usuário (meta semanal, plano ativo, etc.)
    match /user_stats/{userId} {
      allow read, write: if request.auth != null 
                         && request.auth.uid == userId;
    }
    
    // Planos de estudo (editais)
    match /study_plans/{planId} {
      allow read: if request.auth != null 
                  && resource.data.userId == request.auth.uid;
      
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string;
      
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
      
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }
    
    // Registro de questões (acertos/erros)
    match /questions_stats/{docId} {
      allow read: if request.auth != null 
                  && resource.data.userId == request.auth.uid;
      
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.subject is string
                    && request.resource.data.totalQuestions is number;
      
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
      
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }

    // Benchmarks agregados (anônimos)
    // Qualquer usuário autenticado pode ler os benchmarks agregados
    match /benchmarks/{benchmarkId} {
      allow read: if request.auth != null;
    }

    // Benchmarks individuais do usuário
    // Apenas o proprietário pode ler e escrever seu próprio benchmark
    match /user_benchmarks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Eventos do calendário
    // Apenas o proprietário pode gerenciar seus eventos
    match /calendar_events/{eventId} {
      allow read: if request.auth != null 
                  && resource.data.userId == request.auth.uid;
      
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.subject is string
                    && request.resource.data.startTime is timestamp
                    && request.resource.data.endTime is timestamp
                    && request.resource.data.duration is number
                    && request.resource.data.type in ['study', 'review', 'test', 'break']
                    && request.resource.data.status in ['scheduled', 'completed', 'cancelled']
                    && request.resource.data.priority in ['low', 'medium', 'high'];
      
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
      
      allow delete: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }
    
    // Bloqueia tudo que não esteja permitido
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
